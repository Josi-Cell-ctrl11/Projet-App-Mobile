rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Livreurs ──────────────────────────────────────────────────────────
    // Un livreur ne peut lire/modifier que son propre profil
    match /livreurs/{livreurId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == livreurId;
    }

    // ── Commandes disponibles ─────────────────────────────────────────────
    // Tout livreur authentifié peut lire les commandes disponibles
    // Seul le backend (admin SDK) peut créer/supprimer des commandes
    match /commandes/{commandeId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
                    && request.resource.data.livreurId == request.auth.uid;
      allow create, delete: if false; // Backend uniquement
    }

    // ── Gains ─────────────────────────────────────────────────────────────
    // Un livreur ne voit que ses propres gains
    match /gains/{livreurId} {
      allow read: if request.auth != null
                  && request.auth.uid == livreurId;
      allow write: if false; // Backend uniquement
    }

    // ── Retraits ──────────────────────────────────────────────────────────
    match /retraits/{retraitId} {
      allow read: if request.auth != null
                  && resource.data.livreurId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.livreurId == request.auth.uid
                    && request.resource.data.montant >= 1000;
      allow update, delete: if false; // Backend uniquement
    }

    // ── Notifications ─────────────────────────────────────────────────────
    match /notifications/{livreurId}/messages/{msgId} {
      allow read, update: if request.auth != null
                          && request.auth.uid == livreurId;
      allow create, delete: if false; // Backend uniquement
    }

    // Tout le reste est refusé par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
